[Unit]
Description=Frigate camera stack
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
RequiresMountsFor=/srv/frigate

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/abhi/Docker/UbuntuNAS/Frigate
ExecStartPre=/usr/local/sbin/verify-frigate-media
ExecStart=/usr/bin/docker compose up --detach --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=10min
TimeoutStopSec=2min

[Install]
WantedBy=multi-user.target
