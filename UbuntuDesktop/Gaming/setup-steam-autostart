#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ]; then
    echo "Run this script with sudo." >&2
    exit 1
fi

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

install -d -m 700 -o gaming -g gaming /home/gaming/.config
install -d -m 700 -o gaming -g gaming /home/gaming/.config/autostart

install -m 600 -o gaming -g gaming "$script_dir/steam.desktop" \
    /home/gaming/.config/autostart/steam.desktop

echo "Steam Big Picture will start automatically for the gaming account at its next login."
