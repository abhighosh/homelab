- id: panel_action_router
  alias: "Panel action router"
  description: >-
    Routes display slots 1-9 to the corresponding editable Panel action script.
  triggers:
    - trigger: event
      event_type: esphome.cat_panel_action
  conditions:
    - condition: template
      value_template: >-
        {{ trigger.event.data.slot | string in
           ['1', '2', '3', '4', '5', '6', '7', '8', '9'] }}
  actions:
    - action: script.turn_on
      target:
        entity_id: >-
          script.panel_action_{{ trigger.event.data.slot | string }}
  mode: queued
  max: 10

- id: roborock_home_assistant_schedule
  alias: "Roborock · Scheduled clean"
  description: >-
    Starts the Roborock at the configured time when the master schedule and
    the current weekday are enabled.
  triggers:
    - trigger: time
      at: input_datetime.roborock_schedule_time
  conditions:
    - condition: state
      entity_id: input_boolean.roborock_schedule_enabled
      state: "on"
    - condition: template
      value_template: >-
        {% set weekday_helpers = [
          'input_boolean.roborock_schedule_monday',
          'input_boolean.roborock_schedule_tuesday',
          'input_boolean.roborock_schedule_wednesday',
          'input_boolean.roborock_schedule_thursday',
          'input_boolean.roborock_schedule_friday',
          'input_boolean.roborock_schedule_saturday',
          'input_boolean.roborock_schedule_sunday'
        ] %}
        {{ is_state(weekday_helpers[now().weekday()], 'on') }}
    - condition: template
      value_template: >-
        {{ states('vacuum.roborock_q7_l5')
           not in ['cleaning', 'returning', 'unavailable', 'unknown'] }}
  actions:
    - action: vacuum.start
      target:
        entity_id: vacuum.roborock_q7_l5
  mode: single

- id: crowpanel_sonos_favorite
  alias: "CrowPanel · Play Sonos favorite"
  description: >-
    Resolves a CrowPanel favorite slot against the current Sonos Favorites
    sensor and starts it on the kitchen Play:1.
  triggers:
    - trigger: event
      event_type: esphome.crowpanel_media_favorite
  variables:
    favorite_slot: "{{ trigger.event.data.slot | int(0) }}"
    favorite_items: "{{ state_attr('sensor.sonos_favorites', 'items') or {} }}"
    favorite_id: >-
      {% set preferred =
         states('input_text.panel_sonos_favorite_order').split('|') %}
      {% set ns = namespace(recent=[], ordered=[], used=[]) %}
      {% for item_id, label in favorite_items.items() %}
        {% set sequence = item_id.rsplit('/', 1)[-1] | int(0) %}
        {% set ns.recent = ns.recent + [[sequence, item_id, label]] %}
      {% endfor %}
      {% set recent = ns.recent | sort(attribute=0, reverse=true) %}
      {% for requested in preferred %}
        {% set wanted = requested | trim | lower %}
        {% for entry in recent %}
          {% if wanted and entry[2] | lower == wanted and
                entry[1] not in ns.used %}
            {% set ns.ordered = ns.ordered + [entry] %}
            {% set ns.used = ns.used + [entry[1]] %}
          {% endif %}
        {% endfor %}
      {% endfor %}
      {% for entry in recent %}
        {% if entry[1] not in ns.used %}
          {% set ns.ordered = ns.ordered + [entry] %}
          {% set ns.used = ns.used + [entry[1]] %}
        {% endif %}
      {% endfor %}
      {{ ns.ordered[favorite_slot - 1][1]
         if 1 <= favorite_slot <= 12 and
            favorite_slot <= ns.ordered | count else '' }}
  conditions:
    - condition: template
      value_template: "{{ favorite_id | length > 0 }}"
  actions:
    - action: media_player.play_media
      target:
        entity_id: media_player.kitchen_kitchen
      data:
        media_content_type: favorite_item_id
        media_content_id: "{{ favorite_id }}"
        enqueue: replace
  mode: queued
  max: 3

- id: crowpanel_sonos_artwork
  alias: "CrowPanel · Prepare Sonos artwork"
  description: >-
    Converts the current Sonos entity picture to one panel-ready PNG reused by
    the Overview preview and large Media canvas.
  triggers:
    - trigger: state
      id: picture_changed
      entity_id: media_player.kitchen_kitchen
      attribute: entity_picture
    - trigger: homeassistant
      id: ha_started
      event: start
  actions:
    - if:
        - condition: trigger
          id: ha_started
      then:
        - delay: "00:00:20"
    - condition: template
      value_template: >-
        {% set picture = state_attr('media_player.kitchen_kitchen',
                                    'entity_picture') %}
        {{ picture is string and picture | length > 0 }}
    - action: shell_command.update_crowpanel_artwork
      data:
        picture_url: >-
          {{ state_attr('media_player.kitchen_kitchen', 'entity_picture') }}
  mode: restart
