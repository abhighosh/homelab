"""Create one panel-ready PNG from Home Assistant's current Sonos artwork."""

from __future__ import annotations

import io
import os
from pathlib import Path
import sys
import urllib.parse
import urllib.request

from PIL import Image, ImageOps


OUTPUT_DIR = Path("/config/www/crowpanel")
OUTPUT_FILE = OUTPUT_DIR / "sonos-artwork.png"
MAX_DOWNLOAD_BYTES = 5 * 1024 * 1024
# The Overview tile centre-crops this same image, avoiding a second decoded
# RGB565 image in the CrowPanel's PSRAM.
ARTWORK_SIZE = (512, 328)


def artwork_url(value: str) -> str:
    if value.startswith("/"):
        return f"http://127.0.0.1:8123{value}"
    parsed = urllib.parse.urlparse(value)
    if parsed.scheme not in {"http", "https"} or not parsed.netloc:
        raise ValueError("Artwork URL must be HTTP(S) or Home Assistant-relative")
    return value


def download(url: str) -> bytes:
    request = urllib.request.Request(
        url,
        headers={"User-Agent": "Home Assistant CrowPanel artwork/1.0"},
    )
    with urllib.request.urlopen(request, timeout=10) as response:
        declared_size = response.headers.get("Content-Length")
        if declared_size and int(declared_size) > MAX_DOWNLOAD_BYTES:
            raise ValueError("Artwork exceeds the 5 MiB download limit")
        data = response.read(MAX_DOWNLOAD_BYTES + 1)
    if len(data) > MAX_DOWNLOAD_BYTES:
        raise ValueError("Artwork exceeds the 5 MiB download limit")
    return data


def write_png(data: bytes) -> None:
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    temporary = OUTPUT_FILE.with_suffix(".tmp")
    with Image.open(io.BytesIO(data)) as source:
        source.load()
        artwork = ImageOps.fit(
            source.convert("RGB"),
            ARTWORK_SIZE,
            method=Image.Resampling.LANCZOS,
        )
        artwork.save(temporary, format="PNG", optimize=True)
    os.replace(temporary, OUTPUT_FILE)


def main() -> None:
    if len(sys.argv) != 2:
        raise SystemExit("Usage: crowpanel_artwork.py ARTWORK_URL")
    write_png(download(artwork_url(sys.argv[1])))


if __name__ == "__main__":
    main()
