# Copy this file to secrets.yaml. Never commit the real file.
#
# Generate a per-device API key:
#   openssl rand -base64 32
#
# Generate a per-device OTA password:
#   openssl rand -hex 24
#
# Use at least eight characters for the fallback setup hotspot.
cat_panel_01_api_key: REPLACE_WITH_32_BYTE_BASE64_KEY
cat_panel_01_ota_password: REPLACE_WITH_UNIQUE_OTA_PASSWORD
cat_panel_01_fallback_password: REPLACE_WITH_SETUP_HOTSPOT_PASSWORD
