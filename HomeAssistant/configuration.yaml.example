default_config:

homeassistant:
  packages: !include_dir_named packages

# Nginx Proxy Manager terminates HTTPS and reaches Home Assistant from the
# shared proxy bridge. Do not broaden this to all private networks.
http:
  use_x_forwarded_for: true
  trusted_proxies:
    - 172.24.0.0/16

automation: !include automations.yaml
script: !include scripts.yaml
scene: !include scenes.yaml

# The live installation also uses the UI-configured ntfy integration. Its token
# and topic subentry remain protected in Home Assistant's runtime state; the
# camera alert logic itself is mounted from the tracked packages directory.
